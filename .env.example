# ─── Everything here is OPTIONAL ────────────────────────────────────────────
# With no configuration at all, Muzeel runs fully on-device: the browser
# downloads BiRefNet once and every image is processed locally. The variables
# below only enable the server-side "high quality" path.

# fal.ai key for the high-quality path (full BiRefNet at 2048px).
# Without it, GET /api/remove-background reports `available: false` and the UI
# silently sticks to on-device processing.
FAL_KEY=

# Rate limiting for the server path. Strongly recommended in production: the
# endpoint takes no auth, so without a shared store an open deployment will
# drain the fal.ai balance. Vercel's Upstash integration sets these for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SERVER_HOURLY_LIMIT=10

# Cloudflare Turnstile. When TURNSTILE_SECRET_KEY is unset the check is skipped
# entirely and rate limiting is the only gate.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Canonical URL, used for sitemap/robots/OpenGraph.
NEXT_PUBLIC_SITE_URL=https://muzeel.app

# Override where the on-device model is fetched from — e.g. to serve the weights
# from your own CDN instead of the Hugging Face one.
NEXT_PUBLIC_MODEL_URL=
